---
// Página de la app de pacientes en la web: /app/invite/ (destino de los
// enlaces del email de invitación, supabase/functions/send-invite-email) y
// /app/ (descarga general, enlazada desde la landing). Están bajo /app/, así que con la app
// de pacientes instalada el móvil abre la app directamente (Universal Links /
// App Links, ver public/.well-known/); allí la invitación aparece sola al
// iniciar sesión (InviteModal). Sin la app, esta página explica los pasos.
import '../styles/fluxia-tokens.css';
import { APP_STORE_URL, PLAY_STORE_URL, APP_SCHEME_URL } from '../lib/appStores';

interface Props {
  /** invite: email de invitación de un profesional · download: descarga general (/app/, /user antiguo). */
  variant: 'invite' | 'download';
}
const { variant } = Astro.props;
const isInvite = variant === 'invite';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{isInvite ? 'Te han invitado a Fluxia' : 'Descarga Fluxia'}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        padding: 24px 16px; font-family: var(--font-sans); background: var(--gradient-page, #F4F7F3); color: var(--text-primary);
      }
      .card {
        width: 100%; max-width: 440px; background: var(--color-surface, #fff); border-radius: 20px;
        padding: 32px 26px; box-shadow: 0 8px 30px rgba(45, 53, 57, .08);
      }
      .logo { display: block; height: 40px; margin: 0 auto 18px; }
      h1 { font-size: 22px; margin: 0 0 8px; text-align: center; }
      .lede { font-size: 15px; line-height: 1.55; color: var(--text-secondary); margin: 0 0 22px; text-align: center; }
      ol { list-style: none; padding: 0; margin: 0 0 22px; display: flex; flex-direction: column; gap: 14px; }
      li { display: flex; gap: 12px; align-items: flex-start; }
      .num {
        flex: none; width: 28px; height: 28px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center;
        background: var(--color-primary, #3C7DB8); color: #fff; font-weight: 700; font-size: 14px;
      }
      li b { display: block; font-size: 15px; margin-bottom: 2px; }
      li span.t { font-size: 13.5px; color: var(--text-tertiary); line-height: 1.45; }
      .stores { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
      .btn {
        display: block; text-align: center; padding: 13px 18px; border-radius: 12px; text-decoration: none;
        font-size: 15px; font-weight: 700; background: var(--color-primary, #3C7DB8); color: #fff;
      }
      .btn--ghost { background: transparent; color: var(--color-primary, #3C7DB8); border: 1.5px solid var(--color-primary, #3C7DB8); }
      .soon { text-align: center; font-size: 14px; color: var(--text-tertiary); padding: 12px; border-radius: 12px; background: var(--color-surface-sunken, #EEF2EE); }
      .open { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--border-soft, #E5EAE7); text-align: center; }
      .open p { font-size: 13.5px; color: var(--text-tertiary); margin: 0 0 8px; }
    </style>
  </head>
  <body>
    <main class="card">
      <img class="logo" src="/fluxia-logo-full.svg" alt="Fluxia" />
      <h1>{isInvite ? 'Te han invitado a Fluxia' : 'Descarga la app Fluxia'}</h1>
      <p class="lede">
        {isInvite
          ? 'Tu profesional sanitario quiere hacer el seguimiento contigo desde la app Fluxia. Es gratuita.'
          : 'Registra tus deposiciones, micciones y comidas desde el móvil y compártelas con tu profesional sanitario. Es gratuita.'}
      </p>

      <ol>
        <li>
          <span class="num">1</span>
          <div>
            <b>Descarga la app Fluxia</b>
            <span class="t">Desde la App Store (iPhone) o Google Play (Android).</span>
            <div class="stores">
              {APP_STORE_URL ? <a class="btn" href={APP_STORE_URL}>Descargar en la App Store</a> : <div class="soon">App Store: muy pronto</div>}
              {PLAY_STORE_URL ? <a class="btn" href={PLAY_STORE_URL}>Descargar en Google Play</a> : <div class="soon">Google Play: muy pronto</div>}
            </div>
          </div>
        </li>
        <li>
          <span class="num">2</span>
          <div>
            <b>Crea tu cuenta o inicia sesión</b>
            <span class="t">{isInvite ? 'Usa el mismo email en el que has recibido la invitación.' : 'Con tu email o tu cuenta de Google.'}</span>
          </div>
        </li>
        <li>
          <span class="num">3</span>
          <div>
            <b>{isInvite ? 'Acepta la invitación' : 'Vincúlate con tu profesional'}</b>
            <span class="t">{isInvite ? 'Aparecerá en la app al entrar. Acéptala y empieza a registrar.' : 'Si tu profesional te ha invitado, verás la invitación al entrar. Acéptala y empieza a registrar.'}</span>
          </div>
        </li>
      </ol>

      <div class="open">
        <p>¿Ya tienes la app instalada?</p>
        <a class="btn btn--ghost" href={APP_SCHEME_URL}>Abrir Fluxia</a>
      </div>
    </main>
  </body>
</html>
