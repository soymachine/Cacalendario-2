  .pillar h3 { font-size: 18px; margin-bottom: 8px; }
  .pillar p { font-size: 15px; line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: 18px; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; margin-top: auto; }
  .chip {
    font-size: 12.5px; font-weight: 600; color: var(--color-primary);
