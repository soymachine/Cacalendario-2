<script is:inline>
  // Selector mensual / anual del plan Profesional.
  // Los importes viven aquí y en src/lib/billing.ts (que es lo que ve el
  // médico dentro de MW); si cambian, hay que tocar los dos y el Price
  // correspondiente en Stripe.
  (function () {
    var PRICING = {
      month: { amount: '19,95€', period: '/mes · IVA no incluido', save: null },
      year: {
        amount: '199,95€',
        period: '/año · IVA no incluido',
        save: 'Ahorras 39,45€ al año — sale a 16,66€/mes',
      },
    };
    var toggle = document.querySelector('.billing-toggle');
    if (!toggle) return;
    var amountEl = document.getElementById('pro-amount');
    var periodEl = document.getElementById('pro-period');
    var saveEl = document.getElementById('pro-save');

    toggle.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-billing]');
      if (!btn) return;
      var plan = PRICING[btn.getAttribute('data-billing')];
      if (!plan) return;

      Array.prototype.forEach.call(toggle.querySelectorAll('button'), function (b) {
        b.setAttribute('aria-pressed', String(b === btn));
      });
      amountEl.textContent = plan.amount;
      periodEl.textContent = plan.period;
      if (plan.save) {
        saveEl.textContent = plan.save;
        saveEl.hidden = false;
      } else {
        saveEl.hidden = true;
      }
    });
  })();

  // Video modal
  var demoModal = document.getElementById('demo-modal');
  var demoVideo = document.getElementById('demo-video');
  var scrollLockY = 0;
  document.getElementById('video-open').addEventListener('click', function () {
    scrollLockY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = '-' + scrollLockY + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
    demoModal.showModal();
    demoVideo.play();
  });
  demoModal.addEventListener('click', function (e) {
    if (e.target === demoModal) closeDemo();
  });
  document.getElementById('demo-close').addEventListener('click', closeDemo);
  demoModal.addEventListener('close', function () {
    demoVideo.pause();
    demoVideo.currentTime = 0;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    window.scrollTo(0, scrollLockY);
  });
  function closeDemo() {
    demoModal.close();
  }
</script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    gsap.defaults({ ease: 'power2.out', duration: 0.8 });

    // ————— Hero entrance
    const heroAnimated = [
      '.hero-copy .badge', '.hero-copy h1', '.hero-copy .lede',
      '.hero-cta .btn', '.hero-fine', '.hero-tag', '.hero-visual img',
    ];
    // Reset any leftover inline styles from a previous run (e.g. hot reload) before animating.
    gsap.set(heroAnimated, { clearProps: 'all' });

    // Explicit start state for every hero element (avoids relying on from()'s
    // immediateRender timing inside a chained timeline, which was leaving the
    // buttons at full opacity instead of fading in).
    gsap.set('.hero-copy .badge', { autoAlpha: 0, y: 16 });
    gsap.set('.hero-copy h1', { autoAlpha: 0, y: 24 });
    gsap.set('.hero-copy .lede', { autoAlpha: 0, y: 20 });
    gsap.set('.hero-cta .btn', { autoAlpha: 0, y: 16 });
    gsap.set(['.hero-fine', '.hero-tag'], { autoAlpha: 0, y: 12 });
    gsap.set('.hero-visual img', { autoAlpha: 0, y: 28, scale: 0.97 });

    const heroTl = gsap.timeline({
      delay: 0.1,
      onComplete: () => gsap.set(heroAnimated, { clearProps: 'all' }),
    });
    heroTl
      .to('.hero-copy .badge', { autoAlpha: 1, y: 0, duration: 0.6 })
      .to('.hero-copy h1', { autoAlpha: 1, y: 0 }, '-=0.35')
      .to('.hero-copy .lede', { autoAlpha: 1, y: 0 }, '-=0.5')
      .to('.hero-cta .btn', { autoAlpha: 1, y: 0, stagger: 0.1 }, '-=0.45')
      .to(['.hero-fine', '.hero-tag'], { autoAlpha: 1, y: 0, stagger: 0.08 }, '-=0.35')
      .to('.hero-visual img', { autoAlpha: 1, y: 0, scale: 1, duration: 0.9 }, '-=0.7');

    // ————— FAQ answers: animate open/close instead of the instant native <details>
    // toggle, y en acordeón: abrir una respuesta cierra la que estuviera abierta,
    // para que la lista no crezca hasta obligar a buscar la siguiente pregunta.
    const faqItems = document.querySelectorAll('.faq-item');

    const closeFaq = (item, duration = 0.35) => {
      const answer = item.querySelector('.faq-answer');
      if (!answer || !item.hasAttribute('open')) return;
      // Desde 'auto' no se puede animar: se fija la altura actual primero.
      gsap.set(answer, { height: answer.scrollHeight });
      gsap.to(answer, {
        height: 0,
        duration,
        ease: 'power2.inOut',
        onComplete: () => item.removeAttribute('open'),
      });
    };

    const openFaq = (item) => {
      const answer = item.querySelector('.faq-answer');
      if (!answer) return;
      item.setAttribute('open', '');
      gsap.fromTo(
        answer,
        { height: 0 },
        {
          height: answer.scrollHeight,
          duration: 0.4,
          ease: 'power2.inOut',
          onComplete: () => gsap.set(answer, { height: 'auto' }),
        }
      );
    };

    faqItems.forEach((item) => {
      const summary = item.querySelector('summary');
      const answer = item.querySelector('.faq-answer');
      if (!summary || !answer) return;
      gsap.set(answer, { height: 0 });
      summary.addEventListener('click', (e) => {
        e.preventDefault();
        if (item.hasAttribute('open')) {
          closeFaq(item);
          return;
        }
        faqItems.forEach((other) => { if (other !== item) closeFaq(other); });
        openFaq(item);
      });
    });

    // ————— Generic scroll reveal for section headings & standalone blocks
    gsap.utils.toArray('.center, .steps-grid > h2, .security-copy, .specialties-wrap > h2, .specialties-wrap > p, .pricing-wrap h2, .pricing-sub, .faq-wrap h2, .final-cta-inner').forEach((el) => {
      gsap.from(el as Element, {
        autoAlpha: 0,
        y: 28,
        scrollTrigger: { trigger: el as Element, start: 'top 85%', toggleActions: 'play none none none', once: true },
      });
    });

    // ————— Video frame
    gsap.from('.video-frame', {
      autoAlpha: 0,
      y: 32,
      scale: 0.98,
      scrollTrigger: { trigger: '.video-frame', start: 'top 82%', toggleActions: 'play none none none', once: true },
    });

    // ————— Steps (staggered)
    ScrollTrigger.batch('.step', {
      start: 'top 85%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.12, overwrite: true }),
    });
    gsap.set('.step', { autoAlpha: 0, y: 24 });

    // ————— Split sections (visual + copy from opposite sides)
    document.querySelectorAll('.split').forEach((split) => {
      const visual = split.querySelector('.split-visual');
      const copy = split.querySelector('.split-copy');
      const fromLeft = split.querySelector('.split-visual') === split.firstElementChild;
      gsap.from(visual, {
        autoAlpha: 0,
        x: fromLeft ? -40 : 40,
        scrollTrigger: { trigger: split, start: 'top 78%', toggleActions: 'play none none none', once: true },
      });
      gsap.from(copy, {
        autoAlpha: 0,
        x: fromLeft ? 40 : -40,
        scrollTrigger: { trigger: split, start: 'top 78%', toggleActions: 'play none none none', once: true },
      });
    });

    // ————— Benefit cards (staggered)
    gsap.set('.grid-cards .card', { autoAlpha: 0, y: 24 });
    ScrollTrigger.batch('.grid-cards .card', {
      start: 'top 88%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.1, overwrite: true }),
    });

    // ————— Security points (staggered)
    gsap.from('.security-points > div', {
      autoAlpha: 0,
      y: 14,
      stagger: 0.08,
      scrollTrigger: { trigger: '.security-points', start: 'top 85%', toggleActions: 'play none none none', once: true },
    });
    gsap.from('.security-icon .circle', {
      autoAlpha: 0,
      scale: 0.85,
      scrollTrigger: { trigger: '.security-icon', start: 'top 82%', toggleActions: 'play none none none', once: true },
    });

    // ————— Personalización: tipos de registro, pilares y módulo de marca
    gsap.set('.record-type', { autoAlpha: 0, y: 18 });
    ScrollTrigger.batch('.record-type', {
      start: 'top 90%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.08, overwrite: true }),
    });

    gsap.set('.pillar', { autoAlpha: 0, y: 26 });
    ScrollTrigger.batch('.pillar', {
      start: 'top 88%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.1, overwrite: true }),
    });

    gsap.from('.brand-mock-card', {
      autoAlpha: 0,
      scale: 0.94,
      scrollTrigger: { trigger: '.brand-grid', start: 'top 82%', toggleActions: 'play none none none', once: true },
    });
    gsap.set('.brand-point', { autoAlpha: 0, y: 20 });
    ScrollTrigger.batch('.brand-point', {
      start: 'top 90%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.08, overwrite: true }),
    });

    // ————— Specialty tiles (staggered)
    gsap.set('.specialty', { autoAlpha: 0, y: 18 });
    ScrollTrigger.batch('.specialty', {
      start: 'top 90%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.06, overwrite: true }),
    });

    // ————— Pricing cards (staggered)
    gsap.from('.price-card', {
      autoAlpha: 0,
      y: 28,
      stagger: 0.1,
      scrollTrigger: { trigger: '.pricing-grid', start: 'top 85%', toggleActions: 'play none none none', once: true },
    });

    // ————— FAQ items (staggered)
    gsap.set('.faq-item', { autoAlpha: 0, y: 16 });
    ScrollTrigger.batch('.faq-item', {
      start: 'top 90%',
      once: true,
      onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, stagger: 0.06, overwrite: true }),
    });
  });
</script>

</body>
</html>
