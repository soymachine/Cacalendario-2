  .brand-points { flex: 1 1 460px; min-width: 300px; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }
  .brand-point { background: rgba(255,255,255,.14); border-radius: var(--radius-lg); padding: 22px 20px; }
  .brand-point svg { width: 26px; height: 26px; color: #fff; margin-bottom: 12px; display: block; }
  .brand-point h3 { font-size: 16.5px; color: #fff; margin-bottom: 6px; }
  .brand-point p { font-size: 14.5px; line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); }
  .brand-note { max-width: 760px; margin: 40px auto 0; text-align: center; font-size: 14.5px; color: rgba(255,255,255,.8); }

  /* ————————————————————— Benefits grid */
  .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .grid-cards.max-1200 { max-width: 1200px; margin: 0 auto; }
  .card {
    background: var(--color-surface); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); padding: var(--card-pad-lg);
  }
  .card svg { width: 36px; height: 36px; color: var(--lime-500); margin-bottom: 18px; display: block; }
  .card h3 { font-size: 18px; margin-bottom: 8px; }
  .card p { font-size: 15px; line-height: var(--leading-relaxed); color: var(--text-secondary); }

  /* ————————————————————— Security */
  .security-grid { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .security-copy { flex: 1 1 460px; min-width: 300px; }
  .security-copy h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }
  .security-copy p { font-size: 16px; line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: 16px; }
  .security-points { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 10px; }
  .security-points > div { display: flex; align-items: center; gap: 9px; }
  .security-points svg { width: 20px; height: 20px; color: var(--color-primary); }
  .security-points span { font-size: 14.5px; font-weight: 500; color: var(--text-primary); }
  .security-icon { flex: 1 1 320px; min-width: 260px; display: flex; justify-content: center; }
  .security-icon .circle {
    width: 220px; height: 220px; border-radius: 50%; background: var(--color-primary-soft);
    display: flex; align-items: center; justify-content: center;
  }
  .security-icon svg { width: 100px; height: 100px; color: var(--color-primary); }

  /* ————————————————————— Specialties */
  .specialties-wrap { max-width: 1100px; margin: 0 auto; text-align: center; }
  .specialties-wrap h2 { color: #fff; margin-bottom: 14px; }
  .specialties-wrap > p { font-size: 16px; color: rgba(255,255,255,.8); max-width: 560px; margin: 0 auto 44px; }
  .specialties-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .specialty { background: rgba(255,255,255,.14); border-radius: var(--radius-lg); padding: 24px 12px; flex: 1 1 160px; max-width: 200px; }
  .specialty img { width: 48px; height: 48px; margin: 0 auto 12px; display: block; }
  .specialty div { font-size: 13.5px; font-weight: 600; color: #fff; }
  .specialties-note { font-size: 16px; color: rgba(255,255,255,.8); max-width: 1100px; margin: 25px auto !important; text-align: center; }

  /* ————————————————————— Pricing */
  .pricing-wrap { max-width: 1180px; margin: 0 auto; }
  .pricing-wrap h2 { text-align: center; margin-bottom: 14px; }
  .pricing-sub { text-align: center; font-size: 16px; color: var(--text-tertiary); margin-bottom: 52px; }
  .pricing-grid { display: flex; flex-wrap: wrap; gap: 28px; align-items: stretch; justify-content: center; }
  .price-card {
    flex: 1 1 300px; max-width: 360px; border: 1px solid var(--border-soft); border-radius: var(--radius-xl);
    padding: 36px 30px; display: flex; flex-direction: column;
  }
  .price-card--featured {
    max-width: 380px; border: 2px solid var(--color-primary); padding: 44px 32px 36px;
    position: relative; box-shadow: var(--shadow-primary);
  }
  .price-card--trial {
    background: var(--color-surface-sunken); border-style: dashed;
  }
  .price-card--trial .price-name { color: var(--text-secondary); }
  /* Plan aún no disponible: se anuncia, pero sin CTA ni jerarquía visual. */
  .price-card--soon { position: relative; opacity: .72; }
  .price-pill {
    position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
    background: var(--color-primary); color: #fff; font-size: 12.5px; font-weight: 700;
    padding: 6px 16px; border-radius: var(--radius-pill); white-space: nowrap;
  }
  .price-pill--soon { background: var(--color-surface-sunken); color: var(--text-secondary); border: 1px solid var(--border); }
  .price-soon-note { font-size: 13.5px; color: var(--text-tertiary); text-align: center; margin: 0; }
  .price-name { font-size: 18px; font-weight: 600; color: var(--text-primary); margin-bottom: 14px; }
  .price-amount { font-size: 40px; font-weight: 700; font-family: var(--font-display); color: var(--text-primary); line-height: 1; }
  .price-period { font-size: 13px; color: var(--text-tertiary); margin-bottom: 14px; }
  /* Selector mensual / anual dentro de la tarjeta del plan de pago. */
  .billing-toggle {
    display: inline-flex; gap: 2px; padding: 3px; margin-bottom: 14px;
    background: var(--color-surface-sunken); border: 1px solid var(--border-soft); border-radius: var(--radius-pill);
  }
  .billing-toggle button {
    display: inline-flex; align-items: center; gap: 6px;
    border: none; background: transparent; cursor: pointer; font: inherit;
    font-size: 13px; font-weight: 600; color: var(--text-secondary);
    padding: 6px 14px; border-radius: var(--radius-pill); transition: background .15s ease, color .15s ease;
  }
  .billing-toggle button:hover { color: var(--text-primary); }
  .billing-toggle button[aria-pressed="true"] {
    background: var(--color-surface); color: var(--text-primary); box-shadow: var(--shadow-sm, 0 1px 2px rgba(0,0,0,.08));
  }
  .billing-toggle .save-tag {
    font-size: 11px; font-weight: 700; letter-spacing: .01em;
    background: var(--color-success-soft, #E7F5EC); color: var(--color-success, #2F8A5C);
    padding: 2px 7px; border-radius: var(--radius-pill);
  }
  .price-save {
    font-size: 13px; font-weight: 600; color: var(--color-success, #2F8A5C);
    margin: -6px 0 14px;
  }
  .price-save[hidden] { display: none; }
  .price-desc { font-size: 14.5px; color: var(--text-secondary); line-height: 1.5; margin-bottom: 22px; }
  .price-hr { height: 1px; background: var(--border-soft); margin-bottom: 22px; }
  .price-features { display: flex; flex-direction: column; gap: 13px; margin-bottom: 28px; flex: 1; }
  .price-features div { display: flex; gap: 10px; font-size: 14.5px; color: var(--text-primary); }
  .price-features svg { width: 18px; height: 18px; color: var(--color-primary); flex: none; }
  .pricing-contact { text-align: center; font-size: 14px; color: var(--text-tertiary); margin-top: 40px; }
  .pricing-contact a { position: relative; }
  .pricing-contact a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1.5px;
    background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform .25s var(--ease-out, ease);
  }
  .pricing-contact a:hover::after { transform: scaleX(1); }

  /* ————————————————————— FAQ */
  .faq-wrap { max-width: 750px; margin: 0 auto; }
  .faq-wrap h2 { text-align: center; margin-bottom: 44px; }
  .faq-item { border-bottom: 1px solid var(--border-soft); }
  .faq-item summary {
    list-style: none; padding: 20px 0; display: flex; align-items: center; justify-content: space-between;
    gap: 16px; cursor: pointer; font-size: 16.5px; font-weight: 600; color: var(--text-primary);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary svg { width: 20px; height: 20px; color: var(--color-primary); flex: none; transition: transform .25s ease; }
  .faq-item[open] summary svg { transform: rotate(45deg); }
  .faq-answer { height: 0; overflow: hidden; }
  .faq-item p { font-size: 15.5px; line-height: 1.6; color: var(--text-secondary); padding-bottom: 22px; margin: 0; }
  .faq-item p:has(+ .mini-legend) { padding-bottom: 12px; }
  .mini-legend { display: flex; flex-wrap: wrap; gap: 16px; padding-bottom: 22px; }
  .mini-legend-row { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .mini-legend-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; }

  /* ————————————————————— Final CTA */
  .final-cta { text-align: center; color: #fff; }
  .final-cta-inner { max-width: 760px; margin: 0 auto; }
  .final-cta h2 { font-size: clamp(26px, 3.4vw, 38px); font-weight: 700; letter-spacing: var(--tracking-tight); margin-bottom: 18px; color: #fff; }
  .final-cta p { font-size: 17px; color: rgba(255,255,255,.85); margin-bottom: 34px; }
  .final-cta .btn { margin-bottom: 16px; }
  .final-cta .fine { font-size: 13.5px; color: rgba(255,255,255,.78); }

  @media (max-width: 640px) {
    section { padding: 64px 20px; }
    .hero { padding: 56px 20px 64px; }
  }
</style>

<script is:inline>
  (function() {
    var q = window.location.search || '';
    var h = window.location.hash || '';
    if (h.indexOf('access_token') !== -1 || h.indexOf('error_code') !== -1 ||
        q.indexOf('code=') !== -1 || q.indexOf('type=recovery') !== -1) {
      window.location.replace('/user' + q + h);
    }
  })();
</script>
</head>
<body>

<SiteNav home />

<!-- ——————————————————————————— HERO -->
<section class="hero section-brand">
  <div class="hero-grid">
    <div class="hero-copy">
      <span class="badge">Para profesionales sanitarios</span>
      <h1>El seguimiento clínico no termina en la consulta</h1>
      <p class="lede">Fluxia te permite conocer la evolución intestinal, miccional y alimentaria de tus pacientes tal como ocurre, no como la recuerdan. Registros estructurados, actualizados y accesibles desde un único panel.</p>
      <div class="hero-cta">
        <a class="btn btn-lg" href="#pricing">Pruébalo gratis</a>
        <a class="btn btn-lg btn-ghost-inverse" href="#video">Ver cómo funciona</a>
      </div>
      <div class="hero-fine">30 días gratis · Sin tarjeta · Pacientes ilimitados</div>
      <div class="hero-tag">Datos reales. Decisiones mejores.</div>
    </div>
    <div class="hero-visual">
      <img src="/imgs/render.png" alt="Panel clínico de Fluxia en escritorio y app de registro en el móvil" />
    </div>
  </div>
</section>

<!-- ——————————————————————————— VIDEO -->
<section id="video" class="section-sunken">
  <div class="center">
    <h2 class="eyebrow-h2">Descubre Fluxia en un minuto</h2>
    <p style="font-size:16px;color:var(--text-tertiary);margin-bottom:32px">Desde la invitación del paciente hasta la revisión de sus registros en el panel clínico.</p>
    <button class="video-frame" id="video-open" aria-label="Reproducir vídeo de Fluxia">
      <img src="/imgs/video-poster.jpg" alt="Miniatura del vídeo explicativo de Fluxia" />
      <span class="video-play">
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
        </span>
      </span>
    </button>
  </div>
</section>

<!-- ——————————————————————————— INTRO -->
<section class="section-surface">
  <div class="center">
    <h2 style="font-size:clamp(26px,3vw,36px);margin-bottom:20px">Lo que ocurre entre consultas también importa</h2>
    <p style="font-size:17.5px;line-height:var(--leading-relaxed);color:var(--text-secondary);margin-bottom:22px">Cuando el seguimiento depende del papel, una hoja de cálculo o la memoria del paciente, parte de la información se pierde. Fluxia facilita que tus pacientes registren su evolución a medida que ocurre y te presenta los datos de forma clara, ordenada y útil para tu práctica clínica.</p>
    <div style="font-size:17px;font-weight:600;color:var(--color-primary)">Información más fiable. Consultas mejor preparadas.</div>
  </div>
</section>

<!-- ——————————————————————————— HOW IT WORKS -->
<section id="how" class="section-brand">
  <div class="steps-grid">
    <h2 class="eyebrow-h2">Empieza a realizar el seguimiento en tres pasos</h2>
    <div class="steps-row">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Invita al paciente</h3>
        <p>Envía una invitación desde tu panel. El paciente descarga la aplicación (está disponible tanto para iOS como Android) y queda vinculado automáticamente contigo.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>Configura el seguimiento</h3>
        <p>Elige qué debe registrar —deposiciones, micciones y/o comidas—, qué variables necesitas dentro de cada registro y cuándo debes considerar que el caso requiere tu atención.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>Consulta su evolución</h3>
        <p>Accede a los registros desde tu panel, identifica rápidamente qué pacientes requieren atención y consulta el historial completo de cada caso.</p>
      </div>
    </div>
    <div class="steps-cta"><a class="btn btn-lg" href="#pricing">Empieza gratis</a></div>
  </div>
</section>

<!-- ——————————————————————————— PATIENT APP -->
<section class="section-sunken">
  <div class="split">
    <div class="split-visual">
      <img src="/imgs/app_paciente.gif" alt="App del paciente — pantalla de registro" />
    </div>
    <div class="split-copy">
      <h2>Registrar su evolución debe ser sencillo</h2>
      <p>El paciente utiliza Fluxia gratuitamente desde su teléfono móvil. Puede registrar deposiciones y micciones en pocos pasos —consistencia según la Escala de Bristol, características relevantes, síntomas y observaciones— y también lo que come y bebe a lo largo del día: tipo de comida, descripción, ración, etiquetas y, si lo necesitas, una fotografía del plato.</p>
      <p>Solo ve los tipos de registro y los campos que tú has activado para él. Cuando no registra dentro del periodo que has establecido —o se salta la franja de una comida pautada—, Fluxia le envía un recordatorio automático.</p>
      <div class="split-tag">Una experiencia clara y accesible, pensada también para pacientes de edad avanzada. Porque cuando el paciente registra bien, tú decides mejor.</div>
    </div>
  </div>
</section>

<!-- ——————————————————————————— CLINICAL PANEL -->
<section class="section-brand split-reverse">
  <div class="split">
    <div class="split-copy">
      <h2>Todos tus pacientes. Lo importante, a simple vista.</h2>
      <p>El panel clínico de Fluxia te ofrece una visión global del estado de tus pacientes.</p>
      <div class="legend">
        <div class="legend-row"><span class="legend-dot" style="background:var(--success-500)"></span><span><b>Al día:</b> El seguimiento se desarrolla según lo previsto.</span></div>
        <div class="legend-row"><span class="legend-dot" style="background:var(--warning-500)"></span><span><b>Se demora:</b> El paciente empieza a demorarse en sus registros.</span></div>
        <div class="legend-row"><span class="legend-dot" style="background:var(--error-500)"></span><span><b>Requiere atención:</b> El periodo sin registrar supera el límite establecido.</span></div>
      </div>
      <p>Cuando necesitas más información, puedes acceder al historial individual y consultar en detalle la actividad registrada por cada paciente.</p>
    </div>
    <div class="split-visual">
      <img src="/imgs/web_pacientes@2x-8.png" alt="Panel clínico — lista de pacientes con código de colores" />
    </div>
  </div>
</section>

<!-- ——————————————————————————— CUSTOM PROTOCOL -->
<section id="customization" class="section-surface">
  <div class="center">
    <h2 style="font-size:clamp(26px,3vw,34px);margin-bottom:20px">Cada paciente necesita un seguimiento diferente</h2>
    <p style="font-size:17px;line-height:var(--leading-relaxed);color:var(--text-secondary);margin-bottom:12px">Un paciente en estudio de incontinencia, otro en control de estreñimiento crónico y otro en una pauta dietética no necesitan registrar lo mismo. En Fluxia el protocolo no viene impuesto: lo defines tú, paciente a paciente, y puedes cambiarlo en cualquier momento.</p>
  </div>

  <div class="record-types">
    {recordTypes.map(([icon, title, vars]) => (
      <div class="record-type">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon]} />
        <div>
          <h3>{title}</h3>
          <p>{vars}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="pillars">
    {pillars.map(([icon, title, desc, chips], i) => (
      <div class="pillar">
        <div class="pillar-head">
          <span class="pillar-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon]} />
          </span>
          <span class="pillar-step">{`0${i + 1}`}</span>
        </div>
        <h3>{title}</h3>
        <p>{desc}</p>
        <div class="chips">
          {chips.map((c) => <span class="chip">{c}</span>)}
        </div>
      </div>
    ))}
  </div>

  <div class="split protocol-split">
    <div class="split-visual protocol-visual">
      <img src="/imgs/configuracion.jpg" alt="Pantalla de configuración de un paciente: umbrales del semáforo, etiquetas y campos del formulario" loading="lazy" />
    </div>
    <div class="split-copy">
      <h2>Lo configuras una vez y se aplica a ese paciente</h2>
      <p>Desde la ficha de cada paciente defines el semáforo, las etiquetas y los campos del formulario. El módulo de comidas añade además su propia pauta: qué se pide, con qué frecuencia y con qué recordatorios.</p>
      <div class="detail-list">
        {protocolDetails.map(([icon, title, desc]) => (
          <div class="detail-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[icon]} />
            <div>
              <h4>{title}</h4>
              <p>{desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="split-tag">El paciente ve solo lo que necesita registrar.<br />Tú recibes solo la información que necesitas consultar.</div>
    </div>
  </div>
</section>

<!-- ——————————————————————————— BRAND / APP DESIGN -->
<section id="brand" class="section-brand brand-section">
  <div class="brand-wrap">
