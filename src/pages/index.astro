  'shield-check': '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  stethoscope: '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  'user-round': '<circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/>',
  droplets: '<path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>',
  activity: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  syringe: '<path d="m18 2 4 4"/><path d="m17 7 3-3"/><path d="M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5"/><path d="m9 11 4 4"/><path d="m5 19-3 3"/><path d="m14 4 6 6"/>',
  'heart-pulse': '<path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/><path d="M3.22 13H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"/>',
  apple: '<path d="M12 6.528V3a1 1 0 0 1 1-1h0"/><path d="M18.237 21A15 15 0 0 0 22 11a6 6 0 0 0-10-4.472A6 6 0 0 0 2 11a15.1 15.1 0 0 0 3.763 10 3 3 0 0 0 3.648.648 5.5 5.5 0 0 1 5.178 0A3 3 0 0 0 18.237 21"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
};

const faqs = [
  ['¿El paciente tiene que pagar?', 'No. La aplicación es gratuita para el paciente y puede descargarse desde App Store y Google Play.'],
  ['¿Cómo se vincula un paciente con su sanitario?', 'El profesional genera una invitación desde el panel clínico. Cuando el paciente acepta la invitación y accede a la aplicación, queda vinculado automáticamente con su prescriptor.'],
  ['¿Puedo decidir qué debe registrar cada paciente?', 'Sí. Puedes seleccionar las variables necesarias y adaptar el protocolo de seguimiento a cada caso.'],
  ['¿Qué ocurre si un paciente deja de registrar?', 'Fluxia le envía recordatorios automáticos cuando supera el periodo que hayas configurado.'],
  ['¿Puedo ver todos mis pacientes desde un mismo lugar?', 'Sí. El panel ofrece una visión global y utiliza un sistema de colores para ayudarte a identificar rápidamente los casos que pueden requerir atención.'],
  ['¿Quién puede acceder a los datos clínicos?', 'Únicamente el profesional sanitario autorizado y las personas a las que este conceda acceso dentro de su organización.'],
  ['¿Fluxia cumple con el RGPD?', 'Sí. Fluxia opera en cumplimiento del Reglamento General de Protección de Datos. Los datos se almacenan cifrados en servidores europeos y cada centro suscrito firma un acuerdo de encargado de tratamiento que regula el uso y la custodia de la información clínica de sus pacientes.'],
  ['¿Fluxia realiza diagnósticos?', 'No. Fluxia es una herramienta de registro y seguimiento clínico. La interpretación de los datos y las decisiones asistenciales corresponden siempre al profesional sanitario.'],
  ['¿Necesito instalar algún programa?', 'No. El profesional accede a Fluxia desde su navegador y el paciente utiliza la aplicación móvil.'],
  ['¿Puedo cancelar mi suscripción?', 'Sí. Puedes cancelar en cualquier momento desde tu panel, sin permanencia ni penalizaciones.'],
];

const specialties = [
  ['stethoscope', 'Gastroenterología'],
  ['user-round', 'Geriatría'],
  ['droplets', 'Urología'],
  ['activity', 'Coloproctología'],
  ['syringe', 'Enfermería especializada'],
  ['heart-pulse', 'Suelo pélvico'],
  ['apple', 'Nutrición'],
];

const benefits = [
  ['folder-open', 'Seguimiento más fiable', 'Los datos se registran cuando ocurren y permanecen organizados en un único lugar.'],
  ['bell', 'Mayor adherencia', 'Los recordatorios automáticos ayudan al paciente a mantener la continuidad del registro.'],
  ['zap', 'Revisión más rápida', 'El sistema visual te permite detectar de un vistazo qué pacientes pueden requerir atención.'],
  ['clipboard-list', 'Consultas mejor preparadas', 'Accede al historial antes o durante la visita sin tener que reconstruir semanas de información.'],
  ['rocket', 'En marcha en menos de 10 minutos', 'Invita a tus pacientes y empieza a usar Fluxia sin formación previa ni procesos de implantación complejos.'],
  ['file-text', 'Informes exportables', 'Genera informes estructurados listos para adjuntar directamente a la historia clínica.'],
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fluxia Health — Seguimiento clínico de deposiciones y micciones</title>
<meta name="description" content="Fluxia conecta el registro diario del paciente con el panel clínico del profesional sanitario. Registros estructurados, recordatorios automáticos y datos listos para la consulta." />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href={asset('/favicon.ico')} />

<!-- PWA -->
<link rel="manifest" href={asset('/manifest.json')} />
<meta name="theme-color" content="#F4F7F3" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Fluxia" />
<link rel="apple-touch-icon" href={asset('/icons/icon-192x192.png')} />

<style>
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; overflow-x: clip; }
  body {
    font-family: var(--font-sans);
    background: var(--gradient-page);
    background-attachment: fixed;
    color: var(--text-primary);
    line-height: var(--leading-normal);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, h4 { margin: 0; font-family: var(--font-display); color: var(--text-primary); letter-spacing: var(--tracking-snug); font-weight: 600; }
  p { margin: 0; }
  img { max-width: 100%; display: block; }
  a { color: var(--text-link); text-decoration: none; }
  a:hover { color: var(--color-primary-hover); }
  button { font: inherit; cursor: pointer; }
  :focus-visible { outline: none; box-shadow: var(--focus-ring, 0 0 0 3px rgba(60,125,184,.35)); border-radius: var(--radius-sm); }

  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  /* ————————————————————— Buttons (mirrors design-system Button component) */
  .btn {
    --_bg: var(--color-primary); --_fg: var(--color-on-primary); --_bd: transparent;
    --_hover: var(--color-primary-hover); --_active: var(--color-primary-active);
    display: inline-flex; align-items: center; justify-content: center; gap: .55em;
    font-family: var(--font-sans); font-weight: 600; letter-spacing: -0.01em;
    border: 1.5px solid var(--_bd); border-radius: var(--radius-pill); cursor: pointer;
    background: var(--_bg); color: var(--_fg); text-decoration: none; white-space: nowrap;
    min-height: 48px; padding: 0 22px; font-size: var(--text-body);
    box-shadow: var(--shadow-primary);
    transition: background .14s, color .14s, border-color .14s, box-shadow .14s, transform .14s var(--ease-out, ease);
  }
  .btn:hover { background: var(--_hover); color: var(--_fg); }
  .btn:active { transform: scale(.98); background: var(--_active); }
  .btn-lg { min-height: 56px; padding: 0 28px; font-size: var(--text-body-lg); }
  .btn-block { width: 100%; }
  .btn-ghost { --_bg: transparent; --_fg: var(--color-primary); --_bd: var(--border); --_hover: var(--color-primary-soft); box-shadow: none; }
  .btn-ghost:hover { color: var(--color-primary-hover); }
  .btn-ghost-inverse { --_bg: transparent; --_fg: #fff; --_bd: rgba(255,255,255,.6); box-shadow: none; }
  .btn-ghost-inverse:hover { --_hover: rgba(255,255,255,.14); color: var(--color-primary); background: #fff; border-color: #fff; }
  .btn-on-white { background: #fff; color: var(--color-primary); }
  .btn-on-white:hover { background: #fff; color: var(--color-primary-hover); }

  /* ————————————————————— Badge */
  .badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: var(--text-caption); font-weight: 600; line-height: 1;
    padding: 7px 13px; border-radius: var(--radius-pill);
    background: rgba(255,255,255,.22); color: #fff;
  }

  /* ————————————————————— Nav */
  .nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--color-surface-glass-strong);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    box-shadow: none; transition: box-shadow .2s ease;
  }
  .nav.is-scrolled { box-shadow: 0 2px 16px rgba(20,32,28,.08); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 24px; }
  .nav-logo img { height: 44px; width: auto; }
  .nav-links { display: flex; align-items: center; gap: 32px; }
  .nav-links a { position: relative; font-size: 15.5px; font-weight: 700; color: var(--ink-800); }
  .nav-links a:hover { color: var(--color-primary); }
  .nav-links a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px;
    background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform .25s var(--ease-out, ease);
  }
  .nav-links a:hover::after { transform: scaleX(1); }
  .nav-cta { display: flex; align-items: center; gap: 10px; }
  .nav-toggle {
    display: none; background: none; border: none; padding: 8px; color: var(--text-primary);
  }
  .nav-mobile { display: none; flex-direction: column; gap: 2px; padding: 8px 24px 20px; border-top: 1px solid var(--border-soft); }
  .nav-mobile a { position: relative; padding: 12px 0; font-size: 16px; font-weight: 500; color: var(--text-primary); transition: background-color .2s ease, color .2s ease; }
  .nav-mobile a:hover { color: var(--color-primary); background-color: var(--color-primary-soft); }
  .nav-mobile .btn { margin-top: 8px; }
  .nav.is-open .nav-mobile { display: flex; }

  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none; }
    .nav-toggle { display: block; }
  }

  /* ————————————————————— Sections */
  section { padding: 50px 24px; scroll-margin-top: 88px; }
  .section-brand { background: var(--gradient-brand); }
  .section-sunken { background: var(--color-surface-sunken); }
  .section-surface { background: var(--color-surface); }
  .center { max-width: 700px; margin: 0 auto; text-align: center; }
  .eyebrow-h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }

  /* ————————————————————— Hero */
  .hero { padding: 88px 24px 96px; }
  .hero-grid { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .hero-copy { flex: 1 1 460px; min-width: 300px; }
  .hero-copy h1 { font-size: clamp(32px, 4.2vw, 52px); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: #fff; margin: 22px 0; }
  .hero-copy .lede { font-size: var(--text-body-lg); line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); max-width: 520px; margin-bottom: 32px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 18px; }
  .hero-fine { font-size: 13.5px; color: rgba(255,255,255,.75); margin-bottom: 10px; }
  .hero-tag { font-size: 16px; font-weight: 600; color: #fff; }
  .hero-visual { flex: 1 1 460px; min-width: 300px; display: flex; justify-content: center; }
  .hero-visual img { width: 125%; max-width: 125%; height: auto; display: block; }

  /* ————————————————————— Video */
  .video-frame { position: relative; border-radius: var(--radius-2xl); overflow: hidden; cursor: pointer; border: none; padding: 0; display: block; width: 100%; }
  .video-frame img { width: 100%; height: 420px; object-fit: cover; object-position: top; }
  .video-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;
  }
  .video-play span {
    width: 76px; height: 76px; border-radius: 50%; background: rgba(255,255,255,.94);
    display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-lg);
  }
  .video-play svg { width: 30px; height: 30px; color: var(--color-primary); margin-left: 4px; }

  /* ————————————————————— Steps */
  .steps-grid { max-width: 1160px; margin: 0 auto; }
  .steps-grid h2 { text-align: center; color: #fff; margin-bottom: 56px; }
  .steps-row { display: flex; flex-wrap: wrap; gap: 48px; margin-bottom: 48px; }
  .step { flex: 1 1 280px; min-width: 240px; }
  .step-num {
    width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.2); color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700;
    font-family: var(--font-display); margin-bottom: 20px;
  }
  .step h3 { font-size: 19px; color: #fff; margin-bottom: 10px; }
  .step p { font-size: 15.5px; line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); }
  .steps-cta { text-align: center; }

  /* ————————————————————— Split (patient app / clinical panel) */
  .split { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .split-visual { flex: 1 1 380px; min-width: 280px; display: flex; justify-content: center; }
  .split-visual img { width: 100%; max-width: 300px; height: auto; display: block; filter: drop-shadow(0 24px 48px rgba(34,66,100,.16)); }
  .split-copy { flex: 1 1 460px; min-width: 300px; }
  .split-copy h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }
  .split-copy p { font-size: 16.5px; line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: 16px; }
  .split-tag { font-size: 16.5px; font-weight: 600; color: var(--lime-500); line-height: 1.6; }

  .split-reverse { color: #fff; }
  .split-reverse .split-copy h2 { color: #fff; margin-bottom: 18px; }
  .split-reverse .split-copy p { color: rgba(255,255,255,.85); }
  .legend { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  .legend-row { display: flex; align-items: center; gap: 14px; }
  .legend-dot { width: 14px; height: 14px; border-radius: 50%; flex: none; border: 1px solid white; }
  .legend-row span:last-child { font-size: 15.5px; color: #fff; }
  .split-reverse .split-visual img { max-width: 100%; filter: none; }

  /* ————————————————————— Benefits grid */
  .grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .grid-cards.max-1200 { max-width: 1200px; margin: 0 auto; }
  .card {
    background: var(--color-surface); border-radius: var(--radius-xl); box-shadow: var(--shadow-sm); padding: var(--card-pad-lg);
  }
  .card svg { width: 36px; height: 36px; color: var(--lime-500); margin-bottom: 18px; display: block; }
  .card h3 { font-size: 18px; margin-bottom: 8px; }
  .card p { font-size: 15px; line-height: var(--leading-relaxed); color: var(--text-secondary); }

  /* ————————————————————— Security */
  .security-grid { max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .security-copy { flex: 1 1 460px; min-width: 300px; }
  .security-copy h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }
  .security-copy p { font-size: 16px; line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: 16px; }
  .security-points { display: flex; flex-wrap: wrap; gap: 28px; margin-top: 10px; }
  .security-points > div { display: flex; align-items: center; gap: 9px; }
  .security-points svg { width: 20px; height: 20px; color: var(--color-primary); }
  .security-points span { font-size: 14.5px; font-weight: 500; color: var(--text-primary); }
  .security-icon { flex: 1 1 320px; min-width: 260px; display: flex; justify-content: center; }
  .security-icon .circle {
    width: 220px; height: 220px; border-radius: 50%; background: var(--color-primary-soft);
    display: flex; align-items: center; justify-content: center;
  }
  .security-icon svg { width: 100px; height: 100px; color: var(--color-primary); }

  /* ————————————————————— Specialties */
  .specialties-wrap { max-width: 1100px; margin: 0 auto; text-align: center; }
  .specialties-wrap h2 { color: #fff; margin-bottom: 14px; }
  .specialties-wrap > p { font-size: 16px; color: rgba(255,255,255,.8); max-width: 560px; margin: 0 auto 44px; }
  .specialties-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 16px; }
  .specialty { background: rgba(255,255,255,.14); border-radius: var(--radius-lg); padding: 24px 12px; flex: 1 1 160px; max-width: 200px; }
  .specialty svg { width: 32px; height: 32px; color: #fff; margin: 0 auto 12px; display: block; }
  .specialty div { font-size: 13.5px; font-weight: 600; color: #fff; }
  .specialties-note { font-size: 16px; color: rgba(255,255,255,.8); max-width: 1100px; margin: 25px auto !important; text-align: center; }

  /* ————————————————————— Pricing */
  .pricing-wrap { max-width: 1180px; margin: 0 auto; }
  .pricing-wrap h2 { text-align: center; margin-bottom: 14px; }
  .pricing-sub { text-align: center; font-size: 16px; color: var(--text-tertiary); margin-bottom: 52px; }
  .pricing-grid { display: flex; flex-wrap: wrap; gap: 28px; align-items: stretch; justify-content: center; }
  .price-card {
    flex: 1 1 300px; max-width: 360px; border: 1px solid var(--border-soft); border-radius: var(--radius-xl);
    padding: 36px 30px; display: flex; flex-direction: column;
  }
  .price-card--featured {
    max-width: 380px; border: 2px solid var(--color-primary); padding: 44px 32px 36px;
    position: relative; box-shadow: var(--shadow-primary);
  }
  .price-card--trial {
    background: var(--color-surface-sunken); border-style: dashed;
  }
  .price-card--trial .price-name { color: var(--text-secondary); }
  .price-pill {
    position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
    background: var(--color-primary); color: #fff; font-size: 12.5px; font-weight: 700;
