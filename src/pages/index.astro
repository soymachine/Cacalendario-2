          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS.plus} />
        </summary>
        <div class="faq-answer">
          <p>{a}</p>
          {q === '¿Puedo ver todos mis pacientes desde un mismo lugar?' && (
            <div class="mini-legend">
              <span class="mini-legend-row"><span class="mini-legend-dot" style="background:var(--success-500)"></span>Al día</span>
              <span class="mini-legend-row"><span class="mini-legend-dot" style="background:var(--warning-500)"></span>Se demora</span>
              <span class="mini-legend-row"><span class="mini-legend-dot" style="background:var(--error-500)"></span>Requiere atención</span>
            </div>
          )}
        </div>
      </details>
    ))}
  </div>
</section>

