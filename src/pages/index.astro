---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fluxia Health — Seguimiento clínico de deposiciones, micciones y alimentación</title>
<meta name="description" content="Fluxia conecta el registro diario del paciente —deposiciones, micciones y alimentación— con el panel clínico del profesional sanitario. Registros estructurados, configurables paciente a paciente, con recordatorios automáticos y datos listos para la consulta." />

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href={asset('/favicon.ico')} />

<!-- PWA -->
<link rel="manifest" href={asset('/manifest.json')} />
<meta name="theme-color" content="#F4F7F3" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Fluxia" />
<link rel="apple-touch-icon" href={asset('/icons/icon-192x192.png')} />

<style>
  /* ————————————————————— Sections */
  section { padding: 50px 24px; scroll-margin-top: 88px; }
  .section-brand { background: var(--gradient-brand); }
  .section-sunken { background: var(--color-surface-sunken); }
  .section-surface { background: var(--color-surface); }
  .center { max-width: 700px; margin: 0 auto; text-align: center; }
  .eyebrow-h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }

  /* ————————————————————— Hero */
  .hero { padding: 88px 24px 96px; }
  .hero-grid { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .hero-copy { flex: 1 1 460px; min-width: 300px; }
  .hero-copy h1 { font-size: clamp(32px, 4.2vw, 52px); font-weight: 700; line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); color: #fff; margin: 22px 0; }
  .hero-copy .lede { font-size: var(--text-body-lg); line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); max-width: 520px; margin-bottom: 32px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 18px; }
  .hero-fine { font-size: 13.5px; color: rgba(255,255,255,.75); margin-bottom: 10px; }
  .hero-tag { font-size: 16px; font-weight: 600; color: #fff; }
  .hero-visual { flex: 1 1 460px; min-width: 300px; display: flex; justify-content: center; }
  .hero-visual img { width: 125%; max-width: 125%; height: auto; display: block; }

  /* ————————————————————— Video */
  .video-frame { position: relative; border-radius: var(--radius-2xl); overflow: hidden; cursor: pointer; border: none; padding: 0; display: block; width: 100%; }
  .video-frame img { width: 100%; height: 420px; object-fit: cover; object-position: top; }
  .video-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;
  }
  .video-play span {
    width: 76px; height: 76px; border-radius: 50%; background: rgba(255,255,255,.94);
    display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-lg);
  }
  .video-play svg { width: 30px; height: 30px; color: var(--color-primary); margin-left: 4px; }

  #demo-modal::backdrop { background: rgba(0, 0, 0, 0.9); }

  /* ————————————————————— Steps */
  .steps-grid { max-width: 1160px; margin: 0 auto; }
  .steps-grid h2 { text-align: center; color: #fff; margin-bottom: 56px; }
  .steps-row { display: flex; flex-wrap: wrap; gap: 48px; margin-bottom: 48px; }
  .step { flex: 1 1 280px; min-width: 240px; }
  .step-num {
    width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.2); color: #fff;
    display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700;
    font-family: var(--font-display); margin-bottom: 20px;
  }
  .step h3 { font-size: 19px; color: #fff; margin-bottom: 10px; }
  .step p { font-size: 15.5px; line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); }
  .steps-cta { text-align: center; }

  /* ————————————————————— Split (patient app / clinical panel) */
  .split { max-width: 1240px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 64px; align-items: center; }
  .split-visual { flex: 1 1 380px; min-width: 280px; display: flex; justify-content: center; }
  .split-visual img { width: 100%; max-width: 300px; height: auto; display: block; filter: drop-shadow(0 24px 48px rgba(34,66,100,.16)); }
  .split-copy { flex: 1 1 460px; min-width: 300px; }
  .split-copy h2 { font-size: clamp(26px, 3vw, 34px); margin-bottom: 20px; }
  .split-copy p { font-size: 16.5px; line-height: var(--leading-relaxed); color: var(--text-secondary); margin-bottom: 16px; }
  .split-tag { font-size: 16.5px; font-weight: 600; color: var(--lime-500); line-height: 1.6; }

  .split-reverse { color: #fff; }
  .split-reverse .split-copy h2 { color: #fff; margin-bottom: 18px; }
  .split-reverse .split-copy p { color: rgba(255,255,255,.85); }
  .legend { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  .legend-row { display: flex; align-items: center; gap: 14px; }
  .legend-dot { width: 14px; height: 14px; border-radius: 50%; flex: none; border: 1px solid white; }
  .legend-row span:last-child { font-size: 15.5px; color: #fff; }
  .split-reverse .split-visual img { max-width: 100%; filter: none; }

  /* ————————————————————— Personalización del seguimiento (#customization) */
  .record-types {
    max-width: 1100px; margin: 36px auto 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;
  }
  .record-type {
    display: flex; gap: 14px; align-items: flex-start;
    background: var(--color-surface-sunken); border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg); padding: 18px 20px;
