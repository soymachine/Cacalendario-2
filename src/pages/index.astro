---
// Marketing landing page for Fluxia Health
// Design: Fluxia-design-system-rebuild/FluxiaWebsite.dc.html
import { asset } from '../lib/config';
import '../styles/fluxia-tokens.css';

// Inline Lucide icon paths (no runtime CDN dependency).
const ICONS: Record<string, string> = {
