  }
  .brand-mock-logo svg { width: 34px; height: 34px; color: var(--text-tertiary); }
  .brand-mock-name { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--text-primary); }
  .brand-mock-sub { font-size: 13.5px; color: var(--text-tertiary); margin-top: 4px; }
  .brand-mock-swatches { display: flex; justify-content: center; gap: 8px; margin: 22px 0 10px; }
