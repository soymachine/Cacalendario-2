---
// Marketing landing page for Fluxia Health
import { asset } from '../lib/config';
---
<!doctype html>
<html lang="es" data-accent="blue" data-density="comfortable" data-dark="false">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Fluxia Health — Registro clínico de diuresis y deposición</title>

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href={asset('/favicon.ico')} />

<!-- PWA -->
<link rel="manifest" href={asset('/manifest.json')} />
<meta name="theme-color" content="#F0F2F4" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Fluxia" />
<link rel="apple-touch-icon" href={asset('/icons/icon-192x192.png')} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">

<style>
  :root {
    /* Neutrals — cool off-white / graphite */
    --bg: oklch(98.8% 0.003 230);
    --bg-raise: #ffffff;
    --bg-sunk: oklch(96.5% 0.004 230);
    --ink: oklch(22% 0.012 250);
    --ink-2: oklch(38% 0.012 250);
    --ink-3: oklch(55% 0.01 250);
    --ink-4: oklch(72% 0.008 240);
    --line: oklch(91% 0.005 240);
    --line-2: oklch(86% 0.007 240);

    /* Accents — pulled from logo */
    --accent: #2F6DDE;          /* logo blue */
    --accent-ink: #1a4fb0;
    --accent-bg: oklch(96% 0.03 255);
    --lime: #ec9942;            /* logo lime */
    --lime-ink: #7a9410;

    /* Scale */
    --radius: 10px;
    --radius-lg: 18px;
    --radius-xl: 28px;
    --pad-section: 120px;
    --pad-gutter: 32px;

    /* Type */
    --f-display: "Inter Tight", system-ui, sans-serif;
    --f-body: "IBM Plex Sans", system-ui, sans-serif;
    --f-mono: "IBM Plex Mono", ui-monospace, monospace;
  }

  /* Accent variants */
  html[data-accent="green"] { --accent: #4a8f2f; --accent-ink: #2f6b18; --accent-bg: oklch(96% 0.03 145); }
  html[data-accent="teal"]  { --accent: #0f766e; --accent-ink: #0b5a54; --accent-bg: oklch(96% 0.025 190); }
  html[data-accent="violet"]{ --accent: #6d4cd6; --accent-ink: #553aa8; --accent-bg: oklch(96% 0.03 295); }
  html[data-accent="graphite"]{ --accent: #2a2f3a; --accent-ink: #14171e; --accent-bg: oklch(95% 0.005 260); }

  /* Density */
  html[data-density="compact"] { --pad-section: 80px; --pad-gutter: 24px; }

  /* Dark */
  html[data-dark="true"] {
    --bg: oklch(16% 0.012 250);
    --bg-raise: oklch(20% 0.012 250);
    --bg-sunk: oklch(13% 0.01 250);
    --ink: oklch(96% 0.005 240);
    --ink-2: oklch(82% 0.008 240);
    --ink-3: oklch(65% 0.01 240);
    --ink-4: oklch(50% 0.01 240);
    --line: oklch(28% 0.012 250);
    --line-2: oklch(34% 0.012 250);
    --accent-bg: oklch(30% 0.04 255);
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: var(--f-body);
    background: var(--bg);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }

  .wrap { max-width: 1240px; margin: 0 auto; padding: 0 var(--pad-gutter); }

  /* ——————————————————————————— NAV */
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 64px;
  }
  .logo {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--f-display); font-weight: 600; font-size: 20px; letter-spacing: -0.01em;
  }
  .logo img { height: 36px; width: auto; }
  html[data-dark="true"] .logo img { filter: invert(1) brightness(1.1) hue-rotate(180deg); }

  .nav-links { display: flex; gap: 28px; font-size: 14.5px; color: var(--ink-2); }
  .nav-links a { transition: color .15s; }
  .nav-links a:hover { color: var(--ink); }
  .nav-cta { display: flex; gap: 10px; align-items: center; }

  /* Buttons */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 18px; border-radius: 999px;
    font-family: var(--f-body); font-weight: 500; font-size: 14.5px;
    transition: transform .1s, background .15s, border-color .15s;
    border: 1px solid transparent;
    white-space: nowrap;
  }
  .btn-primary { background: var(--ink); color: var(--bg-raise); }
  html[data-dark="true"] .btn-primary { background: var(--bg-raise); color: var(--ink); }
  .btn-primary:hover { background: var(--accent); color: #fff; }
  .btn-ghost { color: var(--ink); border-color: var(--line-2); }
  .btn-ghost:hover { border-color: var(--ink); }
  .btn-link { color: var(--accent); }
  .btn-link:hover { text-decoration: underline; }
  .btn-lg { padding: 14px 22px; font-size: 15.5px; }

  /* ——————————————————————————— HERO */
  .hero { padding: 72px 0 40px; position: relative; }
  .eyebrow {
    font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink-3);
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-raise);
  }
  .eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .h1 {
    font-family: var(--f-display);
    font-size: clamp(42px, 6.2vw, 82px);
    line-height: 0.98; letter-spacing: -0.035em;
    font-weight: 600;
    margin: 20px 0 20px;
    color: var(--ink);
    text-wrap: balance;
  }
  .h1 em { font-style: normal; color: var(--accent); }
  .h1 .mark {
    background: linear-gradient(180deg, transparent 62%, var(--lime) 62%);
    padding: 0 4px;
    font-style: normal;
  }

  .lede {
    font-size: 19px; line-height: 1.5; color: var(--ink-2);
    max-width: 560px; margin: 0 0 28px;
  }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .hero-meta {
    display: flex; gap: 22px; margin-top: 28px;
    font-family: var(--f-mono); font-size: 12px; color: var(--ink-3);
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .hero-meta span { display: inline-flex; align-items: center; gap: 6px; }
  .hero-meta .check { color: var(--accent); font-size: 14px; }

  /* HERO variant: split */
  .hero.split .hero-grid {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center;
  }
  .hero.split .hero-visual { position: relative; height: 620px; overflow: visible; }

  /* Clip the hero visual so absolute mockups never encroach on the copy column */
  .hero .hero-visual { overflow: hidden; border-radius: 16px; }

  /* HERO variant: stacked */
  .hero.stacked { text-align: center; padding-bottom: 20px; }
  .hero.stacked .h1 { max-width: 16ch; margin-inline: auto; }
  .hero.stacked .lede { margin-inline: auto; }
  .hero.stacked .hero-cta { justify-content: center; }
  .hero.stacked .hero-meta { justify-content: center; }
  .hero.stacked .hero-visual { margin-top: 72px; height: 560px; position: relative; }

  /* HERO variant: dashboard-led */
  .hero.dash .hero-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; align-items: center; }
  .hero.dash .hero-visual { position: relative; height: 560px; }

  /* ——————————————————————————— MOCKUPS */
  /* Phone variant showing real app screenshot: hide notch + pad screen */
  .phone-real::before { display: none; }
  .phone-real .phone-screen { background: #f2f2f4; }

  /* Phone */
  .phone {
    position: absolute;
    width: 280px; height: 568px;
    background: var(--bg-raise);
    border-radius: 38px;
    border: 1px solid var(--line-2);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.8) inset,
      0 30px 60px -20px rgba(20,30,60,0.18),
      0 10px 20px -10px rgba(20,30,60,0.08);
    padding: 14px;
    overflow: hidden;
  }
  .phone::before {
    content:""; position: absolute; top: 14px; left: 50%; transform: translateX(-50%);
    width: 90px; height: 22px; background: var(--ink); border-radius: 999px; z-index: 3;
  }
  html[data-dark="true"] .phone::before { background: #000; }
  .phone-screen {
    width: 100%; height: 100%;
    background: var(--bg-sunk);
    border-radius: 26px;
    overflow: hidden;
    position: relative;
    display: flex; flex-direction: column;
  }
  .phone-status {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 24px 10px;
    font-family: var(--f-mono); font-size: 11px; color: var(--ink);
  }
  .phone-status .right { display: flex; gap: 4px; align-items: center; }
  .phone-header {
    padding: 44px 20px 14px;
    display: flex; justify-content: space-between; align-items: flex-end;
  }
  .phone-header .greeting { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; }
  .phone-header .name { font-family: var(--f-display); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-top: 2px; }
  .phone-header .avatar { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, var(--lime), var(--accent)); }

  .phone-today {
    margin: 6px 16px; padding: 14px 16px;
    background: var(--bg-raise); border: 1px solid var(--line); border-radius: 14px;
  }
  .phone-today .label { font-family: var(--f-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); }
  .phone-today .num { font-family: var(--f-display); font-size: 32px; font-weight: 600; letter-spacing: -0.02em; display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
  .phone-today .num small { font-size: 13px; color: var(--ink-3); font-weight: 400; letter-spacing: 0; }
  .phone-today .bars { margin-top: 10px; display: grid; grid-template-columns: repeat(12,1fr); gap: 3px; height: 32px; align-items: end; }
  .phone-today .bars i { background: var(--line-2); border-radius: 2px; display: block; }
  .phone-today .bars i.a { background: var(--accent); }
  .phone-today .bars i.b { background: var(--lime); }

  .phone-log {
    margin: 10px 16px 0; display: flex; flex-direction: column; gap: 6px;
  }
  .phone-log .row {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; background: var(--bg-raise); border: 1px solid var(--line); border-radius: 10px;
  }
  .phone-log .icn { width: 28px; height: 28px; border-radius: 8px; background: var(--bg-sunk); display:flex;align-items:center;justify-content:center; font-family: var(--f-mono); font-size: 10px; color: var(--ink-2); }
  .phone-log .icn.m { background: var(--accent-bg); color: var(--accent-ink); }
  .phone-log .icn.d { background: oklch(95% 0.05 95); color: #7a5810; }
  .phone-log .meta { flex: 1; }
  .phone-log .meta .t { font-weight: 500; font-size: 13px; }
  .phone-log .meta .s { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-3); }
  .phone-log .time { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); }

  .phone-fab {
    position: absolute; bottom: 92px; right: 22px;
    width: 56px; height: 56px; border-radius: 50%;
    background: var(--ink); color: var(--bg-raise);
    display:flex;align-items:center;justify-content:center;
    font-size: 26px; font-weight: 300;
    box-shadow: 0 8px 16px rgba(0,0,0,.2);
  }
  html[data-dark="true"] .phone-fab { background: var(--accent); color: #fff; }
  .phone-tabbar {
    position: absolute; bottom: 0; left: 0; right: 0; height: 74px;
    background: var(--bg-raise); border-top: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4,1fr);
    padding: 10px 12px 22px;
  }
  .phone-tabbar .tab { display:flex;flex-direction:column;align-items:center;gap:4px; font-family: var(--f-mono); font-size: 9.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .phone-tabbar .tab .glyph { width: 20px; height: 20px; border: 1.5px solid var(--ink-3); border-radius: 5px; }
  .phone-tabbar .tab.active { color: var(--accent); }
  .phone-tabbar .tab.active .glyph { border-color: var(--accent); background: var(--accent-bg); }

  /* Dashboard */
  .dash {
    position: absolute;
    background: var(--bg-raise);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
      0 40px 80px -30px rgba(20,30,60,0.22),
      0 10px 20px -10px rgba(20,30,60,0.1);
  }
  .dash-bar {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 14px; border-bottom: 1px solid var(--line);
    background: var(--bg-sunk);
  }
  .dash-bar .dots { display: flex; gap: 6px; }
  .dash-bar .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-2); display: block; }
  .dash-bar .url {
    margin-left: 12px; flex: 1;
    font-family: var(--f-mono); font-size: 11px; color: var(--ink-3);
    background: var(--bg-raise); border: 1px solid var(--line); padding: 5px 10px; border-radius: 6px;
    max-width: 320px;
  }
  .dash-body { display: grid; grid-template-columns: 200px 1fr; min-height: 460px; }
  .dash-side { border-right: 1px solid var(--line); padding: 18px 14px; background: var(--bg-sunk); }
  .dash-side .brand { font-family: var(--f-display); font-weight: 600; font-size: 15px; letter-spacing: -0.01em; margin-bottom: 20px; display:flex; align-items:center; gap: 8px;}
  .dash-side .brand .sq { width: 18px; height: 18px; border-radius: 4px; background: linear-gradient(135deg, var(--lime), var(--accent)); }
  .dash-side .group { font-family: var(--f-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-4); margin: 14px 0 6px; }
  .dash-side .item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 6px; font-size: 13px; color: var(--ink-2); cursor: default;}
  .dash-side .item .g { width: 6px; height: 6px; border-radius: 50%; background: var(--line-2); }
  .dash-side .item.active { background: var(--bg-raise); color: var(--ink); box-shadow: 0 1px 0 rgba(0,0,0,.03); }
  .dash-side .item.active .g { background: var(--accent); }

  .dash-main { padding: 20px 24px; }
  .dash-crumbs { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); margin-bottom: 8px; }
  .dash-h { font-family: var(--f-display); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 18px; display: flex; justify-content: space-between; align-items: center; }
  .dash-h .tag { font-family: var(--f-mono); font-size: 10.5px; background: var(--accent-bg); color: var(--accent-ink); padding: 4px 10px; border-radius: 999px; letter-spacing: 0.04em; }
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }
  .kpi { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: var(--bg-raise); }
  .kpi .l { font-family: var(--f-mono); font-size: 10px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .kpi .v { font-family: var(--f-display); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-top: 4px; }
  .kpi .d { font-family: var(--f-mono); font-size: 11px; margin-top: 2px; color: var(--accent); }
  .kpi .d.neg { color: #c0413c; }

  .chart {
    border: 1px solid var(--line); border-radius: 10px; padding: 16px;
    height: 160px; background: var(--bg-raise);
    display: flex; flex-direction: column;
  }
  .chart .hd { display: flex; justify-content: space-between; align-items: center; font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; }
  .chart .hd .legend { display: flex; gap: 12px; }
  .chart .hd .legend span { display: inline-flex; align-items: center; gap: 5px; color: var(--ink-2); text-transform: none; letter-spacing: 0; }
  .chart .hd .legend i { width: 8px; height: 8px; border-radius: 2px; background: var(--accent); display:inline-block; }
  .chart .hd .legend i.b { background: var(--lime); }
  .chart svg { flex: 1; width: 100%; }

  .pat-table { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; margin-top: 14px; background: var(--bg-raise); }
  .pat-table .r { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 80px; gap: 12px; padding: 10px 14px; font-size: 12.5px; border-bottom: 1px solid var(--line); align-items: center; }
  .pat-table .r:last-child { border-bottom: none; }
  .pat-table .r.hd { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; background: var(--bg-sunk); }
  .pat-table .r .name { display: flex; align-items: center; gap: 8px; }
  .pat-table .r .av { width: 22px; height: 22px; border-radius: 50%; background: var(--bg-sunk); border: 1px solid var(--line-2); font-family: var(--f-mono); font-size: 10px; display:flex;align-items:center;justify-content:center; color: var(--ink-2); }
  .pat-table .r .st { font-family: var(--f-mono); font-size: 10.5px; padding: 2px 8px; border-radius: 999px; display: inline-block; }
  .st.ok { background: oklch(94% 0.05 150); color: #2c6a20; }
  .st.watch { background: oklch(94% 0.06 85); color: #7a5810; }
  .st.alert { background: oklch(94% 0.05 25); color: #a63a33; }
  html[data-dark="true"] .st.ok { background: oklch(30% 0.06 150); color: oklch(85% 0.1 150); }
  html[data-dark="true"] .st.watch { background: oklch(30% 0.08 85); color: oklch(85% 0.12 85); }
  html[data-dark="true"] .st.alert { background: oklch(30% 0.06 25); color: oklch(85% 0.1 25); }

  /* ——————————————————————————— SECTIONS */
  section { padding: var(--pad-section) 0; }
  .kicker {
    font-family: var(--f-mono); font-size: 12px; color: var(--accent);
    letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 16px;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .kicker::before { content:""; width: 18px; height: 1px; background: var(--accent); display: inline-block; }
  .h2 {
    font-family: var(--f-display);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 1; letter-spacing: -0.03em;
    font-weight: 600; margin: 0 0 20px;
    text-wrap: balance;
  }
  .h2-lede { font-size: 18px; color: var(--ink-2); max-width: 620px; line-height: 1.5; margin: 0 0 48px; }

  /* Dark section — invert tokens locally so nested cards keep contrast */
  section.section-dark {
    --bg: oklch(18% 0.012 250);
    --bg-raise: oklch(22% 0.012 250);
    --bg-sunk: oklch(14% 0.01 250);
    --ink: oklch(96% 0.005 240);
    --ink-2: oklch(82% 0.008 240);
    --ink-3: oklch(65% 0.01 240);
    --ink-4: oklch(50% 0.01 240);
    --line: oklch(28% 0.012 250);
    --line-2: oklch(34% 0.012 250);
    --accent-bg: oklch(30% 0.04 255);
    background: var(--bg);
    color: var(--ink);
  }
  section.section-dark .kicker { color: var(--lime); }
  section.section-dark .kicker::before { background: var(--lime); }
  section.section-dark .btn-primary { background: var(--lime); color: oklch(18% 0.012 250); }
  section.section-dark .btn-primary:hover { background: #fff; color: oklch(18% 0.012 250); }
  section.section-dark .btn-ghost { color: var(--ink); border-color: var(--line-2); }

  /* Logos strip */
  .logos {
    padding: 48px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .logos-label { font-family: var(--f-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.08em; text-align: center; margin-bottom: 22px; }
  .logos-grid { display: grid; grid-template-columns: repeat(6,1fr); gap: 24px; align-items: center; opacity: 0.85; }
  .logos-grid .lg {
    height: 32px; display:flex;align-items:center;justify-content:center;
    font-family: var(--f-display); font-weight: 600; font-size: 16px;
    color: var(--ink-3); letter-spacing: -0.01em;
    border: 1px dashed var(--line-2); border-radius: 6px; padding: 0 12px;
  }

  /* Product split */
  .product-split {
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px;
  }
  .product-card {
    background: var(--bg-raise);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    padding: 36px;
