  }

  .protocol-split { margin-top: 56px; }
  .protocol-visual img {
    max-width: 320px; border-radius: var(--radius-xl); border: 1px solid var(--border-soft);
    box-shadow: var(--shadow-lg, 0 24px 48px rgba(34,66,100,.16));
  }
  .detail-list { display: flex; flex-direction: column; gap: 18px; margin: 22px 0 24px; }
  .detail-item { display: flex; gap: 14px; align-items: flex-start; }
  .detail-item svg { width: 22px; height: 22px; flex: none; color: var(--lime-500); margin-top: 3px; }
  .detail-item h4 { font-size: 15.5px; margin-bottom: 3px; }
  .detail-item p { font-size: 14.5px; line-height: 1.55; color: var(--text-secondary); margin: 0; }

  /* ————————————————————— Personalización del diseño de la app (#brand) */
  .brand-wrap { max-width: 1160px; margin: 0 auto; }
  .brand-intro p { font-size: 16.5px; line-height: var(--leading-relaxed); color: rgba(255,255,255,.85); }
  .brand-grid { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; margin-top: 48px; }
  .brand-mock { flex: 1 1 300px; min-width: 260px; display: flex; justify-content: center; }
  .brand-mock-card {
    width: 100%; max-width: 300px; background: #fff; border-radius: var(--radius-2xl);
