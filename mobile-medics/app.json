{
  "expo": {
    "name": "Fluxia Pro",
    "slug": "fluxia-medics",
    "version": "0.90.0",
    "scheme": "fluxiamedics",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7F3",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluxiahealth.medics",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fluxiahealth.medics",
      "adaptiveIcon": {
        "backgroundColor": "#F4F7F3",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
    [
      "expo-image-picker",
      {
        "photosPermission": "Fluxia Pro usa tus fotos solo si eliges una para la imagen de tu consulta o centro, la que ven tus pacientes en su app.",
        "cameraPermission": false,
        "microphonePermission": false
      }
    ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "47c42864-8430-4fe4-aa5b-1a196e701d1b"
      }
    }
  }
}
